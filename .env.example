# Local development only. Never put real credentials into source control.
NODE_ENV=development
AUTH_MODE=local
DATA_BACKEND=json
ADMIN_EMAIL=admin@brightfuture.edu
ADMIN_PASSWORD=change-this-local-password
SESSION_TTL_MINUTES=60
HOST=127.0.0.1
PORT=3000

